@model List<WebApplication15.Models.DonHang>

@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <h3 class="fw-bold mb-4">📦 Đơn hàng của tôi</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-warning">Bạn chưa có đơn hàng nào.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã ĐH</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td>#@d.MaDH</td>
                            <td>@(d.NgayDat.HasValue ? d.NgayDat.Value.ToString("dd/MM/yyyy HH:mm") : "")</td>
                            <td class="text-danger fw-bold">@((d.TongTien ?? 0).ToString("N0")) đ</td>
                            <td>
                                @{
                                    string statusClass = "badge bg-secondary";
                                    string st = d.TrangThaiThanhToan?.ToLower() ?? "";
                                    if (st.Contains("đã thanh toán")) { statusClass = "badge bg-success"; }
                                    else if (st.Contains("chờ") || st.Contains("chưa") || st.Contains("đang xác nhận")) { statusClass = "badge bg-warning text-dark"; }
                                    else if (st.Contains("hủy")) { statusClass = "badge bg-danger"; }
                                }
                                <span class="@statusClass">@d.TrangThaiThanhToan</span>
                            </td>
                            <td>
                                <a class="btn btn-sm btn-info text-white"
                                   href="@Url.Action("DonHangChiTiet", "User", new { id = d.MaDH })">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </a>

                                @if (st.Contains("chờ thanh toán") || st.Contains("đang xác nhận") || st.Contains("chưa thanh toán"))
                                {
                                    <!-- Button trigger modal -->
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-2" data-bs-toggle="modal" data-bs-target="#cancelModal-@d.MaDH">
                                        <i class="bi bi-x-circle"></i> Hủy đơn
                                    </button>

                                    <!-- Modal -->
                                    <div class="modal fade" id="cancelModal-@d.MaDH" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Xác nhận hủy đơn hàng</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Bạn có chắc chắn muốn hủy đơn hàng <strong>#@d.MaDH</strong> không?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                                    @using (Html.BeginForm("HuyDonHang", "User", new { id = d.MaDH }, FormMethod.Post))
                                                    {
                                                        <button type="submit" class="btn btn-danger">Xác nhận hủy</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
