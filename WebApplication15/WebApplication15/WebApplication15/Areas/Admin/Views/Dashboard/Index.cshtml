@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div style="padding-top: 20px;">
    <h2 class="mb-4">📊 Dashboard Quản Lý Mỹ Phẩm</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">📦 Sản Phẩm</h5>
                    <h2 class="display-4" style="font-size: 2.5rem;">@(ViewBag.TotalSanPham ?? 0)</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">📋 Đơn Hàng</h5>
                    <h2 class="display-4" style="font-size: 2.5rem;">@(ViewBag.TotalDonHang ?? 0)</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning mb-3">
                <div class="card-body">
                    <h5 class="card-title">💰 Doanh Thu (Dự kiến)</h5>
                    <h2 class="display-4" style="font-size: 2rem;">@String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:c0}", ViewBag.TongDoanhThu ?? 0)</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info mb-3">
                <div class="card-body">
                    <h5 class="card-title">👥 Khách Hàng</h5>
                    <h2 class="display-4" style="font-size: 2.5rem;">@(ViewBag.TotalNguoiDung ?? 0)</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">📈 Doanh Thu 7 Ngày Gần Đây</h6>
                </div>
                <div class="card-body">
                    <div class="chart-bar">
                        <canvas id="chart7Ngay" style="height: 300px; width: 100%;"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-success">🏆 Top 5 Bán Chạy</h6>
                </div>
                <div class="card-body">
                    <div class="chart-pie pt-4 pb-2">
                        <canvas id="chartTop5" style="height: 250px; width: 100%;"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-info">📊 Doanh Thu 12 Tháng</h6>
        </div>
        <div class="card-body">
            <div class="chart-area">
                <canvas id="chart12Thang" style="height: 350px; width: 100%;"></canvas>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Hàm format tiền tệ
    const formatter = new Intl.NumberFormat('vi-VN', {
        style: 'currency',
        currency: 'VND',
        minimumFractionDigits: 0
    });

    // ----------------------------------------------------
    // 1. BIỂU ĐỒ 7 NGÀY
    // ----------------------------------------------------
    @if (ViewBag.DoanhThu7Ngay != null)
    {
        var data7 = ViewBag.DoanhThu7Ngay as IEnumerable<dynamic>;
        if (data7 != null && data7.Any())
        {
            var labels7 = new List<string>();
            var values7 = new List<decimal>();
            
            foreach (var item in data7)
            {
                // Sử dụng Reflection để lấy dữ liệu từ anonymous type (tránh lỗi RuntimeBinderException)
                var type = item.GetType();
                var pNgay = type.GetProperty("Ngay");
                var pDoanhThu = type.GetProperty("DoanhThu");

                if (pNgay != null && pDoanhThu != null)
                {
                    var ngay = (DateTime)pNgay.GetValue(item, null);
                    var doanhThu = (decimal)pDoanhThu.GetValue(item, null);
                    
                    labels7.Add(ngay.ToString("dd/MM"));
                    values7.Add(doanhThu);
                }
            }
            
            <text>
            var ctx7 = document.getElementById("chart7Ngay").getContext('2d');
            var myChart7 = new Chart(ctx7, {
                type: 'bar',
                data: {
                    labels: [@Html.Raw(string.Join(",", labels7.Select(l => "'" + l + "'")))],
                    datasets: [{
                        label: "Doanh Thu",
                        backgroundColor: "#4e73df",
                        hoverBackgroundColor: "#2e59d9",
                        borderColor: "#4e73df",
                        data: [@Html.Raw(string.Join(",", values7))],
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) { return formatter.format(value); }
                            }
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return formatter.format(context.raw);
                                }
                            }
                        }
                    }
                }
            });
            </text>
        }
    }

    // ----------------------------------------------------
    // 2. BIỂU ĐỒ TOP 5 SẢN PHẨM
    // ----------------------------------------------------
    @if (ViewBag.TopSanPhamBanChay != null)
    {
        var top5 = ViewBag.TopSanPhamBanChay as IEnumerable<dynamic>;
        if (top5 != null && top5.Any())
        {
            var labelsTop5 = new List<string>();
            var valuesTop5 = new List<decimal>();
            
            foreach (var item in top5)
            {
                // Sử dụng Reflection để lấy dữ liệu từ anonymous type
                var type = item.GetType();
                var pTenSP = type.GetProperty("TenSP");
                var pDoanhThu = type.GetProperty("DoanhThu");

                if (pTenSP != null && pDoanhThu != null)
                {
                    var tenSP = pTenSP.GetValue(item, null)?.ToString() ?? "";
                    var doanhThu = (decimal)pDoanhThu.GetValue(item, null);

                    labelsTop5.Add(tenSP.Replace("'", "\\'").Replace("\"", ""));
                    valuesTop5.Add(doanhThu);
                }
            }
            
            <text>
            var ctxTop = document.getElementById("chartTop5").getContext('2d');
            var myPieChart = new Chart(ctxTop, {
                type: 'doughnut',
                data: {
                    labels: [@Html.Raw(string.Join(",", labelsTop5.Select(l => "'" + l + "'")))],
                    datasets: [{
                        data: [@Html.Raw(string.Join(",", valuesTop5))],
                        backgroundColor: ['#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b'],
                        hoverBackgroundColor: ['#2e59d9', '#17a673', '#2c9faf', '#dda20a', '#be2617'],
                        hoverBorderColor: "rgba(234, 236, 244, 1)",
                    }],
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return formatter.format(context.raw);
                                }
                            }
                        }
                    }
                },
            });
            </text>
        }
    }

    // ----------------------------------------------------
    // 3. BIỂU ĐỒ 12 THÁNG
    // ----------------------------------------------------
    @if (ViewBag.DoanhThu12Thang != null)
    {
        var data12 = ViewBag.DoanhThu12Thang as IEnumerable<dynamic>;
        if (data12 != null && data12.Any())
        {
            var labels12 = new List<string>();
            var values12 = new List<decimal>();
            
            foreach (var item in data12)
            {
                // Sử dụng Reflection để lấy dữ liệu từ anonymous type
                var type = item.GetType();
                var pThang = type.GetProperty("Thang");
                var pNam = type.GetProperty("Nam");
                var pDoanhThu = type.GetProperty("DoanhThu");

                if (pThang != null && pNam != null && pDoanhThu != null)
                {
                    var thang = (int)pThang.GetValue(item, null);
                    var nam = (int)pNam.GetValue(item, null);
                    var doanhThu = (decimal)pDoanhThu.GetValue(item, null);

                    labels12.Add("T" + thang + "/" + nam);
                    values12.Add(doanhThu);
                }
            }
            
            <text>
            var ctx12 = document.getElementById("chart12Thang").getContext('2d');
            var myLineChart = new Chart(ctx12, {
                type: 'line',
                data: {
                    labels: [@Html.Raw(string.Join(",", labels12.Select(l => "'" + l + "'")))],
                    datasets: [{
                        label: "Doanh Thu",
                        lineTension: 0.3,
                        backgroundColor: "rgba(78, 115, 223, 0.05)",
                        borderColor: "rgba(78, 115, 223, 1)",
                        pointRadius: 3,
                        pointBackgroundColor: "rgba(78, 115, 223, 1)",
                        pointBorderColor: "rgba(78, 115, 223, 1)",
                        pointHoverRadius: 3,
                        pointHoverBackgroundColor: "rgba(78, 115, 223, 1)",
                        pointHoverBorderColor: "rgba(78, 115, 223, 1)",
                        pointHitRadius: 10,
                        pointBorderWidth: 2,
                        data: [@Html.Raw(string.Join(",", values12))],
                    }],
                },
                options: {
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            ticks: {
                                callback: function(value) { return formatter.format(value); }
                            }
                        }
                    }
                }
            });
            </text>
        }
    }
</script>