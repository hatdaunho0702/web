@model WebApplication15.Models.NhapHang

@{
    ViewBag.Title = "Chi tiết phiếu nhập";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-file-invoice"></i> Chi tiết phiếu nhập #@Model.MaNhap</h4>
                    <a href="@Url.Action("Index")" class="btn btn-light btn-sm">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                </div>
                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-12">
                            <h5 class="text-primary mb-3">
                                <i class="fas fa-info-circle"></i> Thông tin phiếu nhập
                            </h5>
                            <table class="table table-bordered">
                                <tbody>
                                    <tr>
                                        <th width="30%" class="bg-light">
                                            <i class="fas fa-hashtag"></i> Mã phiếu nhập
                                        </th>
                                        <td>
                                            <span class="badge badge-primary badge-lg">PN-@Model.MaNhap.ToString("D6")</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">
                                            <i class="fas fa-box"></i> Sản phẩm
                                        </th>
                                        <td>
                                            @if (Model.SanPham != null)
                                            {
                                                <strong>@Model.SanPham.TenSP</strong>
                                                <span class="text-muted">(Mã SP: @Model.MaSP)</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger">Không xác định</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">
                                            <i class="fas fa-sort-numeric-up"></i> Số lượng nhập
                                        </th>
                                        <td>
                                            <span class="badge badge-success badge-lg">@Model.SoLuongNhap sản phẩm</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">
                                            <i class="fas fa-calendar-alt"></i> Ngày nhập
                                        </th>
                                        <td>
                                            @if (Model.NgayNhap.HasValue)
                                            {
                                                <i class="far fa-clock"></i>
                                                @Model.NgayNhap.Value.ToString("dddd, dd/MM/yyyy HH:mm:ss", new System.Globalization.CultureInfo("vi-VN"))
                                            }
                                            else
                                            {
                                                <span class="text-muted">Không xác định</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">
                                            <i class="fas fa-building"></i> Nhà cung cấp
                                        </th>
                                        <td>
                                            @if (!string.IsNullOrEmpty(Model.NhaCungCap))
                                            {
                                                <strong>@Model.NhaCungCap</strong>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Chưa cập nhật</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">
                                            <i class="fas fa-dollar-sign"></i> Giá vốn (đơn giá)
                                        </th>
                                        <td>
                                            <strong class="text-info">@((Model.GiaVon ?? 0).ToString("N0")) đ</strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">
                                            <i class="fas fa-money-bill-wave"></i> Thành tiền
                                        </th>
                                        <td>
                                            <h4 class="text-success mb-0">
                                                @(((Model.GiaVon ?? 0) * Model.SoLuongNhap).ToString("N0")) đ
                                            </h4>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="bg-light">
                                            <i class="fas fa-sticky-note"></i> Ghi chú
                                        </th>
                                        <td>
                                            @if (!string.IsNullOrEmpty(Model.GhiChu))
                                            {
                                                <div class="alert alert-light mb-0">
                                                    @Model.GhiChu
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Không có ghi chú</span>
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    @if (Model.SanPham != null)
                    {
                        <div class="row mt-4">
                            <div class="col-md-12">
                                <h5 class="text-primary mb-3">
                                    <i class="fas fa-warehouse"></i> Thông tin sản phẩm
                                </h5>
                                <div class="card border-info">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <p><strong>Tên sản phẩm:</strong> @Model.SanPham.TenSP</p>
                                                <p><strong>Giá bán:</strong> <span class="text-success">@((Model.SanPham.GiaBan ?? 0).ToString("N0")) đ</span></p>
                                            </div>
                                            <div class="col-md-6">
                                                <p><strong>Tồn kho hiện tại:</strong> 
                                                    <span class="badge badge-primary">@(Model.SanPham.SoLuongTon ?? 0)</span>
                                                </p>
                                                <p><strong>Trạng thái:</strong> 
                                                    @if ((Model.SanPham.SoLuongTon ?? 0) > 0)
                                                    {
                                                        <span class="badge badge-success">Còn hàng</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-danger">Hết hàng</span>
                                                    }
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="text-center mt-4">
                        <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg">
                            <i class="fas fa-arrow-left"></i> Quay lại danh sách
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 8px;
    }
    .badge-lg {
        font-size: 14px;
        padding: 8px 12px;
    }
    .table th {
        font-weight: 600;
    }
    .table td {
        vertical-align: middle;
    }
</style>
