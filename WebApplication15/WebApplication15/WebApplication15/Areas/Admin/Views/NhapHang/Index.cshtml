@model IEnumerable<WebApplication15.Models.NhapHang>

@{
    ViewBag.Title = "Quản lý nhập hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-box-open"></i> Quản lý nhập hàng</h4>
                    <a href="@Url.Action("Create")" class="btn btn-light btn-sm">
                        <i class="fas fa-plus"></i> Thêm phiếu nhập
                    </a>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    }

                    <!-- Thống kê tổng quan -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div class="card bg-info text-white">
                                <div class="card-body">
                                    <h6>Tổng số phiếu nhập</h6>
                                    <h3>@Model.Count()</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-success text-white">
                                <div class="card-body">
                                    <h6>Tổng số lượng nhập</h6>
                                    <h3>@Model.Sum(x => x.SoLuongNhap)</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-warning text-white">
                                <div class="card-body">
                                    <h6>Tổng giá trị nhập</h6>
                                    <h3>@String.Format("{0:N0} đ", Model.Sum(x => (x.GiaVon ?? 0) * x.SoLuongNhap))</h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bộ lọc tìm kiếm -->
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <form method="get" class="form-inline">
                                <div class="form-group mr-2">
                                    <input type="text" name="search" class="form-control" placeholder="Tìm kiếm sản phẩm, NCC..." value="@Request.QueryString["search"]" />
                                </div>
                                <button type="submit" class="btn btn-primary mr-2">
                                    <i class="fas fa-search"></i> Tìm kiếm
                                </button>
                                <a href="@Url.Action("Index")" class="btn btn-secondary">
                                    <i class="fas fa-redo"></i> Làm mới
                                </a>
                            </form>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" id="nhapHangTable">
                            <thead class="thead-light">
                                <tr>
                                    <th>Mã nhập</th>
                                    <th>Sản phẩm</th>
                                    <th>Số lượng</th>
                                    <th>Ngày nhập</th>
                                    <th>Nhà cung cấp</th>
                                    <th>Giá vốn</th>
                                    <th>Thành tiền</th>
                                    <th>Ghi chú</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.MaNhap</td>
                                            <td>
                                                @if (item.SanPham != null)
                                                {
                                                    @item.SanPham.TenSP
                                                }
                                                else
                                                {
                                                    <span class="text-danger">Không xác định</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge badge-primary">@item.SoLuongNhap</span>
                                            </td>
                                            <td>@(item.NgayNhap?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                            <td>@(string.IsNullOrEmpty(item.NhaCungCap) ? "N/A" : item.NhaCungCap)</td>
                                            <td>@((item.GiaVon ?? 0).ToString("N0")) đ</td>
                                            <td>
                                                <strong class="text-success">@(((item.GiaVon ?? 0) * item.SoLuongNhap).ToString("N0")) đ</strong>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.GhiChu))
                                                {
                                                    if (item.GhiChu.Length > 30)
                                                    {
                                                        <span title="@item.GhiChu">@item.GhiChu.Substring(0, 30)...</span>
                                                    }
                                                    else
                                                    {
                                                        @item.GhiChu
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Details", new { id = item.MaNhap })" class="btn btn-info btn-sm" title="Xem chi tiết">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="text-center text-muted">
                                            <i class="fas fa-inbox fa-3x mb-3"></i>
                                            <p>Chưa có phiếu nhập hàng nào</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 8px;
    }
    .table th {
        background-color: #f8f9fa;
        font-weight: 600;
    }
    .table-hover tbody tr:hover {
        background-color: #f1f3f5;
    }
</style>

<script>
    $(document).ready(function() {
        // Khởi tạo DataTable nếu có nhiều dữ liệu
        @if (Model != null && Model.Count() > 10)
        {
            <text>
            $('#nhapHangTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json"
                },
                "pageLength": 10,
                "order": [[0, "desc"]]
            });
            </text>
        }
    });
</script>
