    </div>
</div>

<!-- =============================================== -->
<!-- PHẦN THỐNG KÊ THANH TOÁN ĐƠN HÀNG -->
<!-- =============================================== -->
<div class="card mt-4 mb-4">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">💳 Thống Kê Thanh Toán Đơn Hàng</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <div class="card border-success">
                    <div class="card-body text-center">
                        <h6>✅ Đơn Hàng Đã Thanh Toán</h6>
                        <h2 class="text-success">@(ViewBag.DonHangDaThanhToan ?? 0)</h2>
                        <p class="text-muted">Tháng này: @(ViewBag.DonHangDaThanhToanThangNay ?? 0)</p>
                        <div class="alert alert-light mt-2">
                            <small>Doanh Thu:</small><br />
                            <strong>@String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:c}", ViewBag.DoanhThuDaThanhToan ?? 0)</strong>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-warning">
                    <div class="card-body text-center">
                        <h6>❌ Đơn Hàng Chưa Thanh Toán</h6>
                        <h2 class="text-warning">@(ViewBag.DonHangChuaThanhToan ?? 0)</h2>
                        <p class="text-muted">Đang chờ thanh toán</p>
                        <div class="alert alert-light mt-2">
                            <small>Doanh Thu:</small><br />
                            <strong>@String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:c}", ViewBag.DoanhThuChuaThanhToan ?? 0)</strong>
