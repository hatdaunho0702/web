<!-- =============================================== -->
<!-- DANH SÁCH ĐƠN HÀNG CHƯA THANH TOÁN -->
<!-- =============================================== -->
@if (ViewBag.DonHangChuaThanhToanTop10 != null)
{
    var donHangChuaThanhToan = ViewBag.DonHangChuaThanhToanTop10 as IEnumerable<dynamic>;
    if (donHangChuaThanhToan != null && donHangChuaThanhToan.Any())
    {
        <div class="card mt-4 mb-4">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">⏰ Top 10 Đơn Hàng Chưa Thanh Toán (Cũ Nhất)</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-warning">
                            <tr>
                                <th>Mã ĐH</th>
                                <th>Khách Hàng</th>
                                <th>Ngày Đặt</th>
                                <th>Tổng Tiền</th>
                                <th>Địa Chỉ</th>
                                <th>Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dh in donHangChuaThanhToan)
                            {
                                try
                                {
                                    int maDH = Convert.ToInt32(dh.MaDH);
                                    DateTime? ngayDat = dh.NgayDat as DateTime?;
                                    decimal tongTien = dh.TongTien != null ? Convert.ToDecimal(dh.TongTien) : 0;
                                    string diaChiGiaoHang = Convert.ToString(dh.DiaChiGiaoHang) ?? "N/A";
                                    
                                    string tenKhachHang = "N/A";
                                    try
                                    {
                                        if (dh.NguoiDung != null)
                                        {
                                            tenKhachHang = Convert.ToString(dh.NguoiDung.HoTen) ?? "N/A";
                                        }
                                    }
                                    catch
                                    {
                                        tenKhachHang = "N/A";
                                    }
                                    
                                    TimeSpan thoiGianConLai = DateTime.Now - (ngayDat ?? DateTime.Now);
                                    
                                    <tr>
                                        <td><strong>#@maDH</strong></td>
                                        <td>@tenKhachHang</td>
                                        <td>
                                            <span class="badge badge-light">@((ngayDat ?? DateTime.Now).ToString("dd/MM/yyyy HH:mm"))</span><br />
                                            <small class="text-muted">@thoiGianConLai.Days ngày trước</small>
                                        </td>
                                        <td>
                                            <strong>@String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:c}", tongTien)</strong>
                                        </td>
                                        <td>
                                            <small>@diaChiGiaoHang</small>
                                        </td>
                                        <td>
                                            <a href="@Url.Action("Details", "DonHang", new { id = maDH })" class="btn btn-sm btn-info" title="Xem Chi Tiết">
                                                <i class="fa fa-eye"></i> Xem
                                            </a>
                                        </td>
                                    </tr>
                                }
                                catch (Exception)
                                {
                                    
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

<!-- Cảnh báo hạn sử dụng -->
@if (ViewBag.SanPhamDaHetHan != null)
{
