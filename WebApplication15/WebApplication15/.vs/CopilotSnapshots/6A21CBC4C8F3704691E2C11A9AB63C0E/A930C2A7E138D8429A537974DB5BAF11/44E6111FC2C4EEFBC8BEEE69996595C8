}

<!-- =============================================== -->
<!-- TOP 5 SẢN PHẨM BÁN CHẠY -->
<!-- =============================================== -->
@if (ViewBag.TopSanPhamBanChay != null)
{
    var topSanPhamBanChay = ViewBag.TopSanPhamBanChay as IEnumerable<dynamic>;
    if (topSanPhamBanChay != null && topSanPhamBanChay.Any())
    {
        <div class="card mt-4 mb-4">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">🏆 Biểu Đồ Top 5 Sản Phẩm Bán Chạy</h5>
            </div>
            <div class="card-body">
                <canvas id="chartTop5SanPham" style="max-height: 400px;"></canvas>
            </div>
        </div>

        <div class="card mt-4 mb-4">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">🏆 Chi Tiết Top 5 Sản Phẩm Bán Chạy</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-warning">
                            <tr>
                                <th>Hạng</th>
                                <th>Mã SP</th>
                                <th>Tên Sản Phẩm</th>
                                <th>Số Lượng Đã Bán</th>
                                <th>Doanh Thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int rank = 1;}
                            @foreach (var sp in topSanPhamBanChay)
                            {
                                try
                                {
                                    int maSP = Convert.ToInt32(sp.MaSP);
                                    string tenSP = Convert.ToString(sp.TenSP) ?? "N/A";
                                    int soLuongDaBan = sp.SoLuongDaBan != null ? Convert.ToInt32(sp.SoLuongDaBan) : 0;
                                    decimal doanhThu = sp.DoanhThu != null ? Convert.ToDecimal(sp.DoanhThu) : 0;
                                    
                                    string rankBadge = rank == 1 ? "badge-danger" : rank == 2 ? "badge-warning" : rank == 3 ? "badge-info" : "badge-secondary";
                                    
                                    <tr>
                                        <td>
                                            <span class="badge @rankBadge" style="font-size: 16px; padding: 8px 12px;">
                                                @if (rank == 1) { <text>🥇</text> }
                                                else if (rank == 2) { <text>🥈</text> }
                                                else if (rank == 3) { <text>🥉</text> }
                                                else { <text>@rank</text> }
                                            </span>
                                        </td>
                                        <td><strong>#@maSP</strong></td>
                                        <td>@tenSP</td>
                                        <td>
                                            <span class="badge badge-primary">@soLuongDaBan sản phẩm</span>
                                        </td>
                                        <td>
                                            <strong class="text-success">@String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:c}", doanhThu)</strong>
                                        </td>
                                    </tr>
                                    rank++;
                                }
                                catch (Exception)
                                {
                                    
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

<!-- =============================================== -->
<!-- PHẦN THỐNG KÊ TỒN KHO -->
<!-- =============================================== -->
