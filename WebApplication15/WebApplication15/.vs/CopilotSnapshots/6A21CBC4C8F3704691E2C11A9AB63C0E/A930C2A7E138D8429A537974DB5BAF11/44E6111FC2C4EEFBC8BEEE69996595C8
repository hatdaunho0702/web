                        <h6>📊 Tháng Này</h6>
                        <h4 class="text-success">@String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:c}", ViewBag.DoanhThuThangNay ?? 0)</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-primary">
                    <div class="card-body text-center">
                        <h6>📈 Năm Nay</h6>
                        <h4 class="text-primary">@String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:c}", ViewBag.DoanhThuNamNay ?? 0)</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-secondary">
                    <div class="card-body text-center">
                        <h6>📉 Năm Trước</h6>
                        <h4 class="text-secondary">@String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:c}", ViewBag.DoanhThuNamTruoc ?? 0)</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =============================================== -->
<!-- BIỂU ĐỒ DOANH THU 7 NGÀY GẦN ĐÂY -->
<!-- =============================================== -->
@if (ViewBag.DoanhThu7Ngay != null)
{
    var doanhThu7Ngay = ViewBag.DoanhThu7Ngay as IEnumerable<dynamic>;
    if (doanhThu7Ngay != null && doanhThu7Ngay.Any())
    {
        <div class="card mt-4 mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">📊 Biểu Đồ Doanh Thu 7 Ngày Gần Đây</h5>
            </div>
            <div class="card-body">
                <canvas id="chart7Ngay" style="max-height: 400px;"></canvas>
            </div>
        </div>

        <div class="card mt-4 mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">📅 Chi Tiết Doanh Thu 7 Ngày Gần Đây</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-info">
                            <tr>
                                <th>Ngày</th>
                                <th>Số Đơn Hàng</th>
                                <th>Doanh Thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in doanhThu7Ngay)
                            {
                                try
                                {
                                    DateTime ngay = Convert.ToDateTime(item.Ngay);
                                    int soDonHang = Convert.ToInt32(item.SoDonHang);
                                    decimal doanhThu = Convert.ToDecimal(item.DoanhThu);
                                    
                                    <tr>
                                        <td><strong>@ngay.ToString("dd/MM/yyyy (dddd)", new System.Globalization.CultureInfo("vi-VN"))</strong></td>
                                        <td>
                                            <span class="badge badge-info">@soDonHang đơn</span>
                                        </td>
                                        <td>
                                            <strong class="text-success">@String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:c}", doanhThu)</strong>
                                        </td>
                                    </tr>
                                }
                                catch (Exception)
                                {
                                    
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-info">
                                <td><strong>TỔNG</strong></td>
                                <td>
                                    @{
                                        int tongDon7Ngay = 0;
                                        decimal tongDoanhThu7Ngay = 0;
                                        foreach (var item in doanhThu7Ngay)
                                        {
                                            try
                                            {
                                                tongDon7Ngay += Convert.ToInt32(item.SoDonHang);
                                                tongDoanhThu7Ngay += Convert.ToDecimal(item.DoanhThu);
                                            }
                                            catch (Exception)
                                            {
                                                
                                            }
                                        }
                                    }
                                    <strong>@tongDon7Ngay đơn</strong>
                                </td>
                                <td><strong>@String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:c}", tongDoanhThu7Ngay)</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
}

<!-- =============================================== -->
<!-- BIỂU ĐỒ DOANH THU 12 THÁNG GẦN ĐÂY -->
<!-- =============================================== -->
@if (ViewBag.DoanhThu12Thang != null)
{
    var doanhThu12Thang = ViewBag.DoanhThu12Thang as IEnumerable<dynamic>;
