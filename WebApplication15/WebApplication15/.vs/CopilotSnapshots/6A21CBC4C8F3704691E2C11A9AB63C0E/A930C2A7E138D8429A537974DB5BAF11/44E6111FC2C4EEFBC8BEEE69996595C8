@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>📊 Dashboard Quản Lý Mỹ Phẩm</h2>
<p>Chào mừng bạn đến trang quản trị.</p>

<!-- Thống kê cơ bản -->
<div class="row mt-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h5 class="card-title">📦 Tổng Sản Phẩm</h5>
                <h2>@(ViewBag.TotalSanPham ?? 0)</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h5 class="card-title">📋 Tổng Đơn Hàng</h5>
                <h2>@(ViewBag.TotalDonHang ?? 0)</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h5 class="card-title">👤 Tổng Tài Khoản</h5>
                <h2>@(ViewBag.TotalTaiKhoan ?? 0)</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <h5 class="card-title">💰 Doanh Thu Tháng</h5>
                <h2>@String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:c}", ViewBag.DoanhThuThangNay ?? 0)</h2>
            </div>
        </div>
    </div>
</div>

<!-- =============================================== -->
<!-- CẢNH BÁO SẢN PHẨM TRÙNG LẶP -->
<!-- =============================================== -->
@if (ViewBag.SanPhamTrungLap != null)
{
    var sanPhamTrungLap = ViewBag.SanPhamTrungLap as IEnumerable<dynamic>;
    if (sanPhamTrungLap != null && sanPhamTrungLap.Any())
    {
        <div class="card mt-4 mb-4 border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">⚠️ CẢNH BÁO: Phát Hiện Sản Phẩm Trùng Lặp!</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-danger">
                    <h5><i class="fa fa-exclamation-triangle"></i> Có <strong>@(ViewBag.TongSanPhamTrungLap ?? 0)</strong> sản phẩm trùng lặp cần xử lý!</h5>
                    <p>Các sản phẩm có cùng tên, thương hiệu và loại sản phẩm.</p>
                    <button type="button" class="btn btn-danger btn-lg" onclick="xoaTatCaSanPhamTrung()">
                        <i class="fa fa-trash"></i> Xóa Tất Cả Sản Phẩm Trùng
                    </button>
                </div>

                <div class="table-responsive mt-3">
                    <table class="table table-striped table-hover">
                        <thead class="table-danger">
                            <tr>
                                <th>Tên Sản Phẩm</th>
                                <th>Thương Hiệu</th>
                                <th>Loại</th>
                                <th>Số Lượng Trùng</th>
                                <th>Chi Tiết</th>
                                <th>Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in sanPhamTrungLap)
                            {
                                try
                                {
                                    string tenSP = Convert.ToString(item.TenSP) ?? "";
                                    string thuongHieu = Convert.ToString(item.ThuongHieu) ?? "N/A";
                                    string loaiSP = Convert.ToString(item.LoaiSP) ?? "N/A";
                                    int soLuongTrung = Convert.ToInt32(item.SoLuongTrung);
                                    var danhSachSP = item.DanhSachSP as List<WebApplication15.Models.SanPham>;
                                    
                                    if (danhSachSP != null && danhSachSP.Count > 0)
                                    {
                                        <tr>
                                            <td><strong>@tenSP</strong></td>
                                            <td>@thuongHieu</td>
                                            <td>@loaiSP</td>
                                            <td>
                                                <span class="badge badge-danger" style="font-size: 14px;">@soLuongTrung sản phẩm</span>
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-info" data-toggle="collapse" data-target="#detail-@danhSachSP[0].MaSP">
                                                    <i class="fa fa-eye"></i> Xem Chi Tiết
                                                </button>
                                            </td>
                                            <td>
                                                @{
                                                    int? maTH = danhSachSP[0].MaTH;
                                                    int? maLoai = danhSachSP[0].MaLoai;
                                                    string maTHStr = maTH.HasValue ? maTH.Value.ToString() : "null";
                                                    string maLoaiStr = maLoai.HasValue ? maLoai.Value.ToString() : "null";
                                                }
                                                <button type="button" class="btn btn-sm btn-danger" onclick="xoaSanPhamTrung('@Html.Raw(tenSP.Replace("'", "\\'").Replace("\"", "&quot;"))', @maTHStr, @maLoaiStr)">
                                                    <i class="fa fa-trash"></i> Xóa Trùng
                                                </button>
                                            </td>
                                        </tr>
                                        <tr class="collapse" id="detail-@danhSachSP[0].MaSP">
                                            <td colspan="6">
                                                <div class="card">
                                                    <div class="card-body">
                                                        <h6>Danh sách các sản phẩm trùng lặp:</h6>
                                                        <table class="table table-sm table-bordered">
                                                            <thead>
                                                                <tr>
                                                                    <th>Mã SP</th>
                                                                    <th>Tên</th>
                                                                    <th>Giá Bán</th>
                                                                    <th>Tồn Kho</th>
                                                                    <th>Ngày Nhập</th>
                                                                    <th>Trạng Thái</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @for (int i = 0; i < danhSachSP.Count; i++)
                                                                {
                                                                    var sp = danhSachSP[i];
                                                                    var isFirst = i == 0;
                                                                    <tr class="@(isFirst ? "table-success" : "")">
                                                                        <td>
                                                                            <strong>#@sp.MaSP</strong>
                                                                            @if (isFirst)
                                                                            {
                                                                                <span class="badge badge-success ml-2">Sẽ giữ lại</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="badge badge-danger ml-2">Sẽ xóa</span>
                                                                            }
                                                                        </td>
                                                                        <td>@sp.TenSP</td>
                                                                        <td>@String.Format("{0:N0} đ", sp.GiaBan)</td>
                                                                        <td>@(sp.SoLuongTon ?? 0)</td>
                                                                        <td>@(sp.NgayNhapKho.HasValue ? sp.NgayNhapKho.Value.ToString("dd/MM/yyyy") : "N/A")</td>
                                                                        <td>@sp.TrangThaiSanPham</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                catch (Exception)
                                {
                                    
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

<!-- =============================================== -->
<!-- THỐNG KÊ DOANH THU CHI TIẾT -->
<!-- =============================================== -->
<div class="card mt-4 mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">💰 Thống Kê Doanh Thu Chi Tiết</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                <div class="card border-info">
                    <div class="card-body text-center">
                        <h6>📅 Hôm Nay</h6>
                        <h4 class="text-info">@String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:c}", ViewBag.DoanhThuHomNay ?? 0)</h4>
                    </div>
