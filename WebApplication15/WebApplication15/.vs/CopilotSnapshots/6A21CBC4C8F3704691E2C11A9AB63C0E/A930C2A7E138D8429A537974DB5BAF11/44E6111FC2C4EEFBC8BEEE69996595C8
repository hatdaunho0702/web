    if (sanPhamDaHetHan != null && sanPhamDaHetHan.Any())
    {
        <div class="row mt-4">
            <div class="col-md-12">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <h4 class="alert-heading">🚨 CẢNH BÁO: Sản Phẩm Đã Hết Hạn!</h4>
                    <p>Có <strong>@sanPhamDaHetHan.Count()</strong> sản phẩm đã vượt quá hạn sử dụng. Vui lòng xóa hoặc dừng bán.</p>
                    <table class="table table-sm table-striped mt-3">
                        <thead>
                            <tr>
                                <th>Mã SP</th>
                                <th>Tên Sản Phẩm</th>
                                <th>Hạn Sử Dụng</th>
                                <th>Tồn Kho</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sp in sanPhamDaHetHan)
                            {
                                try
                                {
                                    int maSP = Convert.ToInt32(sp.MaSP);
                                    string tenSP = Convert.ToString(sp.TenSP) ?? "N/A";
                                    object hanSuDungObj = sp.HanSuDung;
                                    DateTime? hanSuDung = hanSuDungObj as DateTime?;
                                    int soLuongTon = sp.SoLuongTon != null ? Convert.ToInt32(sp.SoLuongTon) : 0;
                                    
                                    <tr>
                                        <td>@maSP</td>
                                        <td>@tenSP</td>
                                        <td>
                                            @if (hanSuDung.HasValue)
                                            {
                                                <span class="badge badge-danger">@hanSuDung.Value.ToString("dd/MM/yyyy")</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">N/A</span>
                                            }
                                        </td>
                                        <td>@soLuongTon</td>
                                    </tr>
                                }
                                catch (Exception)
                                {
                                    
                                }
                            }
                        </tbody>
                    </table>
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
        </div>
    }
}

<!-- Cảnh báo sắp hết hạn -->
@if (ViewBag.SanPhamSapHetHan != null)
{
    var sanPhamSapHetHan = ViewBag.SanPhamSapHetHan as IEnumerable<dynamic>;
    if (sanPhamSapHetHan != null && sanPhamSapHetHan.Any())
    {
        <div class="row mt-4">
            <div class="col-md-12">
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <h4 class="alert-heading">⚠️ CẢNH BÁO: Sản Phẩm Sắp Hết Hạn (3 tháng nữa)</h4>
                    <p>Có <strong>@sanPhamSapHetHan.Count()</strong> sản phẩm sắp hết hạn. Hãy chạy chương trình sale để xả hàng kịp thời.</p>
                    <table class="table table-sm table-striped mt-3">
                        <thead>
                            <tr>
                                <th>Mã SP</th>
                                <th>Tên Sản Phẩm</th>
                                <th>Hạn Sử Dụng</th>
                                <th>Tồn Kho</th>
                                <th>Ngày Còn Lại</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sp in sanPhamSapHetHan)
                            {
                                try
                                {
                                    DateTime ngayHienTai = DateTime.Now;
                                    int maSP = Convert.ToInt32(sp.MaSP);
                                    string tenSP = Convert.ToString(sp.TenSP) ?? "N/A";
                                    object hanSuDungObj = sp.HanSuDung;
                                    DateTime? hanSuDung = hanSuDungObj as DateTime?;
                                    int soLuongTon = sp.SoLuongTon != null ? Convert.ToInt32(sp.SoLuongTon) : 0;
                                    int ngayConLai = 0;
                                    
                                    if (hanSuDung.HasValue)
                                    {
                                        ngayConLai = (int)(hanSuDung.Value - ngayHienTai).TotalDays;
                                    }
                                    
                                    <tr>
                                        <td>@maSP</td>
                                        <td>@tenSP</td>
                                        <td>
                                            @if (hanSuDung.HasValue)
                                            {
                                                <span class="badge badge-warning">@hanSuDung.Value.ToString("dd/MM/yyyy")</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">N/A</span>
                                            }
                                        </td>
                                        <td>@soLuongTon</td>
                                        <td><strong>@ngayConLai</strong> ngày</td>
                                    </tr>
                                }
                                catch (Exception)
                                {
                                    
                                }
                            }
                        </tbody>
                    </table>
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
        </div>
    }
}

<!-- Load Chart.js from CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>

<script>
    // ===============================================
    // BIỂU ĐỒ DOANH THU 7 NGÀY
    // ===============================================
    @if (ViewBag.DoanhThu7Ngay != null)
    {
        var doanhThu7NgayChart = ViewBag.DoanhThu7Ngay as IEnumerable<dynamic>;
        if (doanhThu7NgayChart != null && doanhThu7NgayChart.Any())
        {
            <text>
            var ctx7Ngay = document.getElementById('chart7Ngay').getContext('2d');
            var chart7Ngay = new Chart(ctx7Ngay, {
                type: 'bar',
                data: {
                    labels: [
                        @foreach (var item in doanhThu7NgayChart)
                        {
                            try
                            {
                                DateTime ngay = Convert.ToDateTime(item.Ngay);
                                @Html.Raw("'" + ngay.ToString("dd/MM") + "',")
                            }
                            catch (Exception)
                            {
                                
                            }
                        }
                    ],
                    datasets: [{
                        label: 'Doanh Thu (VNĐ)',
                        data: [
                            @foreach (var item in doanhThu7NgayChart)
                            {
                                try
                                {
                                    decimal doanhThu = Convert.ToDecimal(item.DoanhThu);
                                    @Html.Raw(doanhThu.ToString() + ",")
                                }
                                catch (Exception)
                                {
                                    @Html.Raw("0,")
                                }
                            }
                        ],
                        backgroundColor: 'rgba(54, 162, 235, 0.6)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 2
                    }, {
                        label: 'Số Đơn Hàng',
                        data: [
                            @foreach (var item in doanhThu7NgayChart)
                            {
                                try
                                {
                                    int soDonHang = Convert.ToInt32(item.SoDonHang);
                                    @Html.Raw(soDonHang.ToString() + ",")
                                }
                                catch (Exception)
                                {
                                    @Html.Raw("0,")
                                }
                            }
                        ],
                        type: 'line',
                        backgroundColor: 'rgba(255, 99, 132, 0.2)',
                        borderColor: 'rgba(255, 99, 132, 1)',
                        borderWidth: 2,
                        yAxisID: 'y1'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            position: 'left',
                            title: {
                                display: true,
                                text: 'Doanh Thu (VNĐ)'
                            },
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        },
                        y1: {
                            beginAtZero: true,
                            position: 'right',
                            title: {
                                display: true,
                                text: 'Số Đơn Hàng'
                            },
                            grid: {
                                drawOnChartArea: false
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top'
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    var label = context.dataset.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    if (context.datasetIndex === 0) {
                                        label += context.parsed.y.toLocaleString('vi-VN') + ' đ';
                                    } else {
                                        label += context.parsed.y + ' đơn';
                                    }
                                    return label;
                                }
                            }
                        }
                    }
                }
            });
            </text>
        }
    }

    // ===============================================
    // BIỂU ĐỒ DOANH THU 12 THÁNG
    // ===============================================
    @if (ViewBag.DoanhThu12Thang != null)
    {
        var doanhThu12ThangChart = ViewBag.DoanhThu12Thang as IEnumerable<dynamic>;
        if (doanhThu12ThangChart != null && doanhThu12ThangChart.Any())
        {
            <text>
            var ctx12Thang = document.getElementById('chart12Thang').getContext('2d');
            var chart12Thang = new Chart(ctx12Thang, {
                type: 'line',
                data: {
                    labels: [
                        @foreach (var item in doanhThu12ThangChart)
                        {
                            try
                            {
                                int thang = Convert.ToInt32(item.Thang);
                                int nam = Convert.ToInt32(item.Nam);
                                @Html.Raw("'" + thang + "/" + nam + "',")
                            }
                            catch (Exception)
                            {
                                
                            }
                        }
                    ],
                    datasets: [{
                        label: 'Doanh Thu (VNĐ)',
                        data: [
                            @foreach (var item in doanhThu12ThangChart)
                            {
                                try
                                {
                                    decimal doanhThu = Convert.ToDecimal(item.DoanhThu);
                                    @Html.Raw(doanhThu.ToString() + ",")
                                }
                                catch (Exception)
                                {
                                    @Html.Raw("0,")
                                }
                            }
                        ],
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        borderColor: 'rgba(75, 192, 192, 1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Doanh Thu (VNĐ)'
                            },
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Tháng/Năm'
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top'
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return 'Doanh Thu: ' + context.parsed.y.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    }
                }
            });
            </text>
        }
    }

    // ===============================================
    // BIỂU ĐỒ TOP 5 SẢN PHẨM BÁN CHẠY
    // ===============================================
    @if (ViewBag.TopSanPhamBanChay != null)
    {
        var topSanPhamBanChayChart = ViewBag.TopSanPhamBanChay as IEnumerable<dynamic>;
        if (topSanPhamBanChayChart != null && topSanPhamBanChayChart.Any())
        {
            <text>
            var ctxTop5 = document.getElementById('chartTop5SanPham').getContext('2d');
            var chartTop5 = new Chart(ctxTop5, {
                type: 'bar',
                data: {
                    labels: [
                        @foreach (var sp in topSanPhamBanChayChart)
                        {
                            try
                            {
                                string tenSP = Convert.ToString(sp.TenSP) ?? "N/A";
                                // Rút ngắn tên nếu quá dài
                                if (tenSP.Length > 25)
                                {
                                    tenSP = tenSP.Substring(0, 25) + "...";
                                }
                                @Html.Raw("'" + tenSP.Replace("'", "\\'") + "',")
                            }
                            catch (Exception)
                            {
                                
                            }
                        }
                    ],
                    datasets: [{
                        label: 'Số Lượng Đã Bán',
                        data: [
                            @foreach (var sp in topSanPhamBanChayChart)
                            {
                                try
                                {
                                    int soLuongDaBan = sp.SoLuongDaBan != null ? Convert.ToInt32(sp.SoLuongDaBan) : 0;
                                    @Html.Raw(soLuongDaBan.ToString() + ",")
                                }
                                catch (Exception)
                                {
                                    @Html.Raw("0,")
                                }
                            }
                        ],
                        backgroundColor: [
                            'rgba(255, 99, 132, 0.6)',
                            'rgba(255, 159, 64, 0.6)',
                            'rgba(54, 162, 235, 0.6)',
                            'rgba(153, 102, 255, 0.6)',
                            'rgba(75, 192, 192, 0.6)'
                        ],
                        borderColor: [
                            'rgba(255, 99, 132, 1)',
                            'rgba(255, 159, 64, 1)',
                            'rgba(54, 162, 235, 1)',
                            'rgba(153, 102, 255, 1)',
                            'rgba(75, 192, 192, 1)'
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    indexAxis: 'y',
                    scales: {
                        x: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Số Lượng'
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return 'Đã bán: ' + context.parsed.x + ' sản phẩm';
                                }
                            }
                        }
                    }
                }
            });
            </text>
        }
    }

    function xoaSanPhamTrung(tenSP, maTH, maLoai) {
        if (!confirm('Bạn có chắc chắn muốn xóa các sản phẩm trùng lặp này?\n\nHệ thống sẽ giữ lại sản phẩm có mã nhỏ nhất và cộng tồn kho.')) {
            return;
        }

        $.ajax({
            url: '@Url.Action("XoaSanPhamTrung", "Dashboard")',
            type: 'POST',
            data: {
                tenSP: tenSP,
                maTH: maTH,
                maLoai: maLoai
            },
            success: function(response) {
                if (response.success) {
                    alert(response.message);
                    location.reload();
                } else {
                    alert('Lỗi: ' + response.message);
                }
            },
            error: function() {
                alert('Có lỗi xảy ra khi xóa sản phẩm trùng lặp!');
            }
        });
    }

    function xoaTatCaSanPhamTrung() {
        if (!confirm('⚠️ CẢNH BÁO!\n\nBạn có chắc chắn muốn xóa TẤT CẢ sản phẩm trùng lặp?\n\nHệ thống sẽ:\n- Giữ lại sản phẩm có mã nhỏ nhất\n- Cộng tồn kho vào sản phẩm được giữ lại\n- Xóa các sản phẩm trùng còn lại (nếu chưa có trong đơn hàng)')) {
            return;
        }

        $.ajax({
            url: '@Url.Action("XoaTatCaSanPhamTrung", "Dashboard")',
            type: 'POST',
            success: function(response) {
                if (response.success) {
                    alert(response.message);
                    location.reload();
                } else {
                    alert('Lỗi: ' + response.message);
                }
            },
            error: function() {
                alert('Có lỗi xảy ra khi xóa sản phẩm trùng lặp!');
            }
        });
    }
</script>

