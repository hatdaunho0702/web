                    <h3 class="text-primary">@(ViewBag.SoLuongTonTatCa ?? 0) <small>đơn vị</small></h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="alert alert-success">
                    <h6>✅ Đã Bán</h6>
